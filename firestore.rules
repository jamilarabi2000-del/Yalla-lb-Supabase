rules_version = '2';

// =============================================================================
// Yalla Lebanon - Cloud Firestore Security Rules
//
// THREAT MODEL
// This application has no trusted backend: the React client talks straight to
// Firestore with the (public) Web API key. Every check written in TypeScript is
// therefore a user-experience affordance, not a control - an attacker calls the
// Firestore REST/gRPC API with their own ID token and never runs your code.
//
// THIS FILE IS THE ONLY SECURITY BOUNDARY. Assume every field of every write is
// attacker-chosen.
//
// Every hasOnly() list below is pinned to what the application actually writes.
// If you add a field to a payload, add it here too or the write will be denied.
// `npm run test:rules` covers both directions: attacks must fail, and the real
// client payloads must succeed.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      return isSignedIn()
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    // Admin authorization:
    // Firebase custom admin claim ONLY
    function isAdmin() {
      return isSignedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    // Seller authorization:
    // Firebase custom seller claim ONLY
    function isSeller() {
      return isSignedIn()
        && 'seller' in request.auth.token
        && request.auth.token.seller == true;
    }

    function getSellerId() {
      return ('sellerId' in request.auth.token && request.auth.token.sellerId is string) ? request.auth.token.sellerId : null;
    }

    function isActiveSeller() {
      return isSeller()
        && getSellerId() != null
        && exists(/databases/$(database)/documents/sellers/$(getSellerId()))
        && get(/databases/$(database)/documents/sellers/$(getSellerId())).data.get('isActive', true) == true;
    }

    // Step-up verification marker:
    // Requires that an authoritative server-issued verification record exists in admin_stepup/{uid}
    // and has not expired (within 30-minute validity window).
    function hasRecentAdminStepUp() {
      return isAdmin()
        && exists(/databases/$(database)/documents/admin_stepup/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_stepup/$(request.auth.uid))
             .data.get('expiresAtMs', 0) > request.time.toMillis();
    }

    function isNotBanned() {
      return isSignedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == false);
    }

    // ---------------------------------------------------------------------
    // Value guards
    // ---------------------------------------------------------------------

    function isMoney(v, maxValue) {
      return v is number && v >= 0 && v <= maxValue;
    }

    function boundedString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // ---------------------------------------------------------------------
    // Health / probe ping document used by connection testing
    // ---------------------------------------------------------------------

    match /test/{docId} {
      allow read: if docId == 'connection';
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Catalogue
    // ---------------------------------------------------------------------

    function productShapeOk() {
      return request.resource.data.priceUSD is number
        && request.resource.data.priceUSD >= 0
        && request.resource.data.priceUSD <= 1000000
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= 1000000
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 250;
    }

    function sellerForbiddenProductKeys() {
      return [
        'sellerActive',
        'rating',
        'reviewCount',
        'reviewsCount',
        'ordersCount',
        'soldCount',
        'featured',
        'isPromoted',
        'isNewArrival',
        'isFeatured',
        'isBestseller',
        'displayOrder',
        'discountPercentage',
        'sellerItemCode',
        'lowStockThreshold',
        'lowStockNotice',
        'customStockLabel',
        'costPriceUSD'
      ];
    }

    function sellerProductPayloadOk() {
      return !request.resource.data.keys().hasAny(sellerForbiddenProductKeys());
    }

    match /products/{productId} {
      allow get, list: if resource.data.get('isPublished', true) == true
        || isAdmin()
        || (resource.data.get('sellerId', '') == getSellerId() && isActiveSeller());

      allow create: if isAdmin()
        || (
          isActiveSeller()
          && request.resource.data.get('id', '') == productId
          && request.resource.data.get('sellerId', '') == getSellerId()
          && sellerProductPayloadOk()
          && productShapeOk()
        );

      allow update: if isAdmin()
        || (
          isActiveSeller()
          && resource.data.get('sellerId', '') == getSellerId()
          && request.resource.data.get('sellerId', '') == getSellerId()
          && request.resource.data.get('id', productId) == productId
          && productShapeOk()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'arabicName',
            'artisan',
            'seller',
            'arabicSeller',
            'origin',
            'category',
            'priceUSD',
            'originalPriceUSD',
            'image',
            'additionalImages',
            'videoUrl',
            'additionalVideos',
            'videos',
            'description',
            'craftStory',
            'stock',
            'isPublished',
            'tags',
            'keywords',
            'arabicKeywords',
            'seoTitle',
            'seoArabicTitle',
            'seoDescription',
            'seoArabicDescription',
            'weightOrVolume',
            'createdAt',
            'updatedAt'
          ])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'id',
            'sellerId',
            'sellerActive',
            'rating',
            'reviewCount',
            'reviewsCount',
            'ordersCount',
            'soldCount',
            'featured',
            'isPromoted',
            'isNewArrival',
            'isFeatured',
            'isBestseller',
            'displayOrder',
            'discountPercentage',
            'sellerItemCode',
            'lowStockThreshold',
            'lowStockNotice',
            'customStockLabel',
            'costPriceUSD'
          ])
        );

      allow delete: if hasRecentAdminStepUp()
        || (
          isActiveSeller()
          && resource.data.get('sellerId', '') == getSellerId()
        );
    }

    match /product_private/{productId} {
      allow read: if isAdmin()
        || (
          isSeller()
          && resource.data.get('sellerId', '') == getSellerId()
        );

      allow create, update, delete: if isAdmin()
        || (
          isSeller()
          && (resource == null || resource.data.get('sellerId', '') == getSellerId())
          && request.resource.data.get('sellerId', '') == getSellerId()
        );
    }

    match /product_bundles/{bundleId} {
      allow get, list: if resource.data.get('isActive', true) == true || isAdmin();
      allow write: if hasRecentAdminStepUp();
    }

    match /categories/{catId} {
      allow get, list: if resource.data.get('isPublished', true) == true || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if hasRecentAdminStepUp();
    }

    // ---------------------------------------------------------------------
    // Seller company profile
    // ---------------------------------------------------------------------

    function noPrivateSellerFields() {
      return !request.resource.data.keys().hasAny([
        'accountEmail',
        'accountUid',
        'commissionPct',
        'exactAddress'
      ]);
    }

    function sellerSelfEditableKeys() {
      return [
        'id',
        'sellerCode',
        'nameEn',
        'nameAr',
        'bio',
        'bioEn',
        'bioAr',
        'village',
        'district',
        'governorate',
        'region',
        'phone',
        'contactPhone',
        'whatsapp',
        'contactEmail',
        'logoUrl',
        'bannerImage',
        'profileImage',
        'craftCategory',
        'updatedAt'
      ];
    }

    match /sellers/{sellerId} {
      allow get, list: if resource.data.get('isActive', true) == true
        || isAdmin()
        || (isSeller() && sellerId == getSellerId());

      allow create: if isAdmin()
        && noPrivateSellerFields();

      allow update: if (
          isAdmin()
          && noPrivateSellerFields()
        )
        || (
          isSeller()
          && sellerId == getSellerId()
          && request.resource.data.get('id', sellerId) == getSellerId()
          && noPrivateSellerFields()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(sellerSelfEditableKeys())
        );

      allow delete: if hasRecentAdminStepUp();
    }

    // ---------------------------------------------------------------------
    // Restricted seller record
    // ---------------------------------------------------------------------

    match /seller_private/{sellerId} {
      allow read: if isAdmin()
        || (
          isSeller()
          && sellerId == getSellerId()
        );

      allow create: if isAdmin()
        || (
          isSeller()
          && sellerId == getSellerId()
          && request.resource.data.keys().hasOnly([
            'exactAddress',
            'updatedAt'
          ])
        );

      allow update: if isAdmin()
        || (
          isSeller()
          && sellerId == getSellerId()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'exactAddress',
                 'updatedAt'
               ])
        );

      allow delete: if hasRecentAdminStepUp();
    }

    // ---------------------------------------------------------------------
    // Seller applications: Server-only creation via submitSellerApplication Cloud Function
    // Direct client creation (including anonymous and authenticated users) is strictly forbidden.
    // Applications are read, approved, or rejected exclusively by administrators.
    // ---------------------------------------------------------------------

    match /seller_applications/{appId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /seller_application_rate_limits/{docId} {
      allow read, write: if false;
    }

    match /seller_application_locks/{lockId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // CMS / configuration
    // ---------------------------------------------------------------------

    match /discounts/{discountId} {
      allow get, list: if resource.data.get('isActive', true) == true || isAdmin();
      allow write: if (isAdmin() || hasRecentAdminStepUp()) && !request.resource.data.keys().hasAny(['couponCode', 'maxTotalUses', 'maxUsesPerUser']);
    }

    match /coupons/{couponId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || hasRecentAdminStepUp();
    }

    match /shipping_rules/{ruleId} {
      allow get, list: if resource.data.get('isActive', true) == true || isAdmin();
      allow write: if isAdmin();
    }

    match /cms/{docId} {
      allow read, write: if isAdmin();
    }

    match /cms_public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_versions/{versionId} {
      allow read, write: if isAdmin();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin registry is never client-writable.
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // User accounts and profiles
    // ---------------------------------------------------------------------

    function userEmailMatchesAuth() {
      return !('email' in request.resource.data)
        || request.resource.data.email == ''
        || request.auth.token.get('email', '') == ''
        || request.resource.data.email.lower() == request.auth.token.get('email', '').lower();
    }

    function userSelfEditableKeys() {
      return [
        'uid',
        'name',
        'firstName',
        'lastName',
        'email',
        'phone',
        'avatar',
        'defaultGovernorate',
        'defaultCity',
        'defaultAddress',
        'defaultBuilding',
        'defaultNotes',
        'updatedAt',
        'createdAt'
      ];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if (
          isOwner(userId)
          && isNotBanned()
          && request.resource.data.get('uid', '') == userId
          && request.resource.data.keys().hasOnly(userSelfEditableKeys())
          && userEmailMatchesAuth()
          && !request.resource.data.keys().hasAny([
            'role',
            'sellerId',
            'isBanned',
            'ordersPlaced'
          ])
        )
        || isAdmin();

      allow update: if (
          isOwner(userId)
          && isNotBanned()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(userSelfEditableKeys())
          && userEmailMatchesAuth()
          && !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny([
                 'role',
                 'sellerId',
                 'isBanned',
                 'ordersPlaced',
                 'uid'
               ])
        )
        || isAdmin();

      allow delete: if hasRecentAdminStepUp();
    }

    // ---------------------------------------------------------------------
    // Phone uniqueness index
    // ---------------------------------------------------------------------

    function phoneRegistryPayloadOk(phoneKey) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'phone',
          'formatted',
          'cleanDigits',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('cleanDigits', '') is string
        && request.resource.data.get('cleanDigits', '').size() >= 7
        && request.resource.data.get('cleanDigits', '').size() <= 12
        && boundedString(
          request.resource.data.get('phone', ''),
          32
        )
        && boundedString(
          request.resource.data.get('formatted', ''),
          32
        )
        && (
          phoneKey == 'phone_' +
            request.resource.data.get('cleanDigits', '')
          ||
          phoneKey == '961' +
            request.resource.data.get('cleanDigits', '')
        );
    }

    match /phone_registry/{phoneKey} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (
          isSignedIn()
          && isNotBanned()
          && phoneRegistryPayloadOk(phoneKey)
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && isNotBanned()
          && resource.data.get('uid', '') == request.auth.uid
          && phoneRegistryPayloadOk(phoneKey)
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && isNotBanned()
          && resource.data.get('uid', '') == request.auth.uid
        );
    }

    // ---------------------------------------------------------------------
    // Carts and wishlists
    // ---------------------------------------------------------------------

    function cartPayloadOk(userId) {
      return request.resource.data.keys().hasOnly(['userId', 'items', 'updatedAt'])
        && request.resource.data.get('userId', userId) == userId
        && (!('items' in request.resource.data) || (
          request.resource.data.items is list
          && request.resource.data.items.size() <= 50
        ))
        && (!('updatedAt' in request.resource.data) || boundedString(request.resource.data.updatedAt, 40));
    }

    function wishlistPayloadOk(userId) {
      return request.resource.data.keys().hasOnly(['userId', 'productIds', 'updatedAt'])
        && request.resource.data.get('userId', userId) == userId
        && (!('productIds' in request.resource.data) || (
          request.resource.data.productIds is list
          && request.resource.data.productIds.size() <= 200
        ))
        && (!('updatedAt' in request.resource.data) || boundedString(request.resource.data.updatedAt, 40));
    }

    match /carts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) && isNotBanned() && cartPayloadOk(userId)) || isAdmin();
      allow delete: if (isOwner(userId) && isNotBanned()) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) && isNotBanned() && wishlistPayloadOk(userId)) || isAdmin();
      allow delete: if (isOwner(userId) && isNotBanned()) || isAdmin();
    }

    // ---------------------------------------------------------------------
    // ORDERS - authoritative Cloud Function only
    // ---------------------------------------------------------------------

    function sellerOrderPatchOk() {
      return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ])
        && request.resource.data.status in [
          'pending',
          'confirmed',
          'crafting',
          'courier_assigned',
          'in_transit',
          'delivered',
          'cancelled',
          'returned'
        ];
    }

    match /orders/{orderId} {
      allow get: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('userId', '') == request.auth.uid
        );

      allow list: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('userId', '') == request.auth.uid
        );

      // Customer checkout MUST go through the authoritative placeOrder Cloud Function.
      // Direct Firestore creation from ANY client identity (including admins) is strictly forbidden.
      allow create: if false;

      allow update: if isAdmin();

      allow delete: if hasRecentAdminStepUp();
    }

    // ---------------------------------------------------------------------
    // Seller Order Fulfillment Documents
    // ---------------------------------------------------------------------

    function isValidStatusTransition(oldStatus, newStatus) {
      return (oldStatus == 'pending' && (newStatus == 'confirmed' || newStatus == 'cancelled'))
        || (oldStatus == 'confirmed' && (newStatus == 'crafting' || newStatus == 'cancelled'))
        || (oldStatus == 'crafting' && (newStatus == 'courier_assigned' || newStatus == 'cancelled'))
        || (oldStatus == 'courier_assigned' && (newStatus == 'in_transit' || newStatus == 'cancelled'))
        || (oldStatus == 'in_transit' && (newStatus == 'delivered' || newStatus == 'cancelled'))
        || (oldStatus == 'delivered' && newStatus == 'returned')
        || (oldStatus == newStatus);
    }

    function sellerFulfillmentPatchOk() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('status', 'pending');
      let newStatus = request.resource.data.get('status', 'pending');
      return diff.hasOnly(['status', 'updatedAt', 'fulfillmentNotes', 'sellerTrackingNumber'])
        && request.resource.data.get('orderId', '') == resource.data.get('orderId', '')
        && request.resource.data.get('sellerId', '') == resource.data.get('sellerId', '')
        && !diff.hasAny(['trackingNumber'])
        && isValidStatusTransition(oldStatus, newStatus);
    }

    match /order_fulfillment/{orderId}/sellers/{sellerId} {
      allow get, list: if isAdmin()
        || (
          isSeller()
          && getSellerId() == sellerId
          && (resource == null || resource.data.get('sellerId', '') == getSellerId())
        );

      allow create: if false;

      allow update: if isAdmin()
        || (
          isSeller()
          && getSellerId() == sellerId
          && resource.data.get('sellerId', '') == getSellerId()
          && sellerFulfillmentPatchOk()
        );

      allow delete: if hasRecentAdminStepUp();
    }

    // ---------------------------------------------------------------------
    // Order idempotency records - authoritative Cloud Function only
    // ---------------------------------------------------------------------

    match /order_idempotency/{idempotencyId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Product reviews
    // ---------------------------------------------------------------------

    function reviewOrderProvesPurchase(orderId, productId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.get('userId', '') == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.get('status', '') == 'delivered'
        && 'productIds' in get(/databases/$(database)/documents/orders/$(orderId)).data
        && get(/databases/$(database)/documents/orders/$(orderId)).data.productIds is list
        && get(/databases/$(database)/documents/orders/$(orderId)).data.productIds.hasAny([productId]);
    }

    function reviewBodyOk() {
      return request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.rating == math.floor(
          request.resource.data.rating
        )
        && boundedString(
          request.resource.data.comment,
          2000
        )
        && boundedString(
          request.resource.data.get('userName', ''),
          120
        )
        && boundedString(
          request.resource.data.get('createdAt', ''),
          40
        )
        && boundedString(
          request.resource.data.get('date', ''),
          40
        );
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isNotBanned()
        && request.resource.data.keys().hasOnly([
          'id',
          'productId',
          'userName',
          'rating',
          'comment',
          'date',
          'createdAt',
          'updatedAt'
        ])
        && !request.resource.data.keys().hasAny(['userId', 'orderId', 'userEmail', 'email', 'adminReply', 'adminReplyAt'])
        && request.resource.data.get('productId', '') is string
        && reviewId == request.auth.uid + '_' + request.resource.data.get('productId', '')
        && reviewBodyOk()
        && exists(/databases/$(database)/documents/review_private/$(reviewId));

      allow update: if isAdmin()
        || (
          isSignedIn()
          && isNotBanned()
          && exists(/databases/$(database)/documents/review_private/$(reviewId))
          && get(/databases/$(database)/documents/review_private/$(reviewId)).data.get('userId', '') == request.auth.uid
          && !request.resource.data.keys().hasAny(['userId', 'orderId', 'adminReply', 'adminReplyAt'])
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'rating',
                 'comment',
                 'updatedAt'
               ])
          && reviewBodyOk()
        );

      allow delete: if hasRecentAdminStepUp()
        || (
          isSignedIn()
          && isNotBanned()
          && exists(/databases/$(database)/documents/review_private/$(reviewId))
          && get(/databases/$(database)/documents/review_private/$(reviewId)).data.get('userId', '') == request.auth.uid
        );
    }

    match /review_private/{reviewId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('userId', '') == request.auth.uid
        );

      allow create: if isSignedIn()
        && isNotBanned()
        && request.resource.data.keys().hasOnly([
          'id',
          'reviewId',
          'userId',
          'orderId',
          'productId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.get('userId', '') == request.auth.uid
        && reviewId == request.auth.uid + '_' + request.resource.data.get('productId', '')
        && reviewOrderProvesPurchase(
          request.resource.data.get('orderId', ''),
          request.resource.data.get('productId', '')
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && isNotBanned()
          && resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        );

      allow delete: if hasRecentAdminStepUp()
        || (
          isSignedIn()
          && isNotBanned()
          && resource.data.get('userId', '') == request.auth.uid
        );
    }

    match /order_notes/{orderId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Admin activity, audit logs and system config
    // ---------------------------------------------------------------------

    match /recent_activity/{activityId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /inventory_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin step-up verification audit collection - server only via Admin SDK
    match /admin_stepup/{uid} {
      allow read, write: if false;
    }

    // Admin email OTP challenge collection - server only via Admin SDK
    match /admin_otps/{docId} {
      allow read, write: if false;
    }

    // Legacy OTPs collection - strictly inaccessible
    match /otps/{otpId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Search analytics
    // ---------------------------------------------------------------------

    match /search_logs/{logId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && isNotBanned()
        && 'userId' in request.resource.data
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id',
          'query',
          'timestamp',
          'userId',
          'userEmail',
          'userName',
          'origin',
          'resultsCount',
          'language',
          'filterCategory',
          'filterRegion',
          'createdAt'
        ])
        && request.resource.data.query is string
        && request.resource.data.query.size() > 0
        && request.resource.data.query.size() <= 200
        && (
          !('userEmail' in request.resource.data)
          || (
            'email' in request.auth.token
            && request.resource.data.userEmail == request.auth.token.email
          )
        )
        && (
          !('userName' in request.resource.data)
          || boundedString(request.resource.data.userName, 120)
        )
        && (
          !('timestamp' in request.resource.data)
          || boundedString(request.resource.data.timestamp, 40)
        )
        && (
          !('origin' in request.resource.data)
          || request.resource.data.origin in ['navbar', 'products_page', 'mobile_menu', 'direct']
        );

      allow update, delete: if isAdmin();
    }
  }
}